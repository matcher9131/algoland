# Supabase project settings -> Database -> Connection string (use the pooler
# URI, port 6543, for serverless workloads).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase project settings -> API -> Project URL. Used to derive the JWKS
# endpoint that verifies access tokens.
SUPABASE_URL=https://<project-ref>.supabase.co

# Vercel routes container traffic to port 80 unless PORT is set. Keep this in
# sync with the Vercel project settings.
PORT=8080
