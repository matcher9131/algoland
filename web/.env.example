# Supabase project settings -> API
# Exposed to the browser: safe to publish, protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Injected automatically by the Vercel service binding declared in vercel.json.
# Set it by hand only for local development without `vercel dev`.
API_URL=http://localhost:8080
